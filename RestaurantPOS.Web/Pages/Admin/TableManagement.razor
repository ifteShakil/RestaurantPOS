@page "/admin/tables"
@using RestaurantPOS.Shared.DTOs.Table
@inject RestaurantPOS.Web.Services.ApiService ApiService
@inject RestaurantPOS.Web.Services.AppState AppState
@inject ISnackbar Snackbar
@implements IDisposable

<MudText Typo="Typo.h4" Class="mb-4" Style="color:#0a1f44; font-weight:700;">
    Tables — @AppState.CurrentBranchName
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:12px;">
    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">Add New Table</MudText>

    <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-start;">
        <MudTextField T="string" @bind-Value="formName" Label="Table Name" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Placeholder="e.g., Table 5" Style="width:200px;" />
        <MudNumericField T="int" @bind-Value="formCapacity" Label="Capacity (seats)" Variant="Variant.Outlined"
                         Margin="Margin.Dense" HideSpinButtons="true" Min="1" Style="width:160px;" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddTable" Style="height:40px;">
            Add
        </MudButton>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@errorMessage</MudAlert>
    }
</MudPaper>

@if (tables == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudGrid>
        @foreach (var t in tables)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="2" Style="@GetCardStyle(t.Status)">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                        <MudText Typo="Typo.h6" Style="font-weight:700;">@t.Name</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="() => DeleteTable(t.Id)" />
                    </div>
                    <MudText Typo="Typo.body2" Class="mb-2" Style="opacity:0.7;">Seats: @t.Capacity</MudText>

                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(t.Status)" Class="mb-3">@t.Status</MudChip>

                    <MudSelect T="string" Value="t.Status" ValueChanged="(val) => ChangeStatus(t.Id, val)"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem T="string" Value="@("Available")">Available</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Occupied")">Occupied</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Reserved")">Reserved</MudSelectItem>
                        <MudSelectItem T="string" Value="@("NeedsCleaning")">Needs Cleaning</MudSelectItem>
                    </MudSelect>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<TableDto>? tables;
    private string formName = "";
    private int formCapacity = 4;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += HandleBranchChanged;
        await LoadTables();
    }

    private async Task LoadTables() => tables = await ApiService.GetTablesByBranchAsync(AppState.CurrentBranchId);

    private async void HandleBranchChanged()
    {
        await LoadTables();
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddTable()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(formName) || formCapacity <= 0)
        {
            errorMessage = "Table name and valid capacity are required.";
            return;
        }

        var dto = new CreateTableDto
        {
            Name = formName,
            Capacity = formCapacity,
            BranchId = AppState.CurrentBranchId
        };

        var success = await ApiService.CreateTableAsync(dto);
        if (success)
        {
            Snackbar.Add("Table added!", Severity.Success);
            formName = "";
            formCapacity = 4;
            await LoadTables();
        }
        else
        {
            errorMessage = "Failed to save.";
        }
    }

    private async Task ChangeStatus(int tableId, string newStatus)
    {
        var success = await ApiService.UpdateTableStatusAsync(tableId, newStatus);
        if (success)
        {
            Snackbar.Add("Table status updated.", Severity.Info);
            await LoadTables();
        }
    }

    private async Task DeleteTable(int id)
    {
        var success = await ApiService.DeleteTableAsync(id);
        if (success)
        {
            Snackbar.Add("Table deleted.", Severity.Info);
            await LoadTables();
        }
    }

    private string GetCardStyle(string status)
    {
        var borderColor = status switch
        {
            "Available" => "#1a7a4c",
            "Occupied" => "#c62828",
            "Reserved" => "#d9822b",
            "NeedsCleaning" => "#757575",
            _ => "#e0e0e0"
        };
        return $"border-radius:12px; border-left:5px solid {borderColor};";
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Available" => Color.Success,
        "Occupied" => Color.Error,
        "Reserved" => Color.Warning,
        "NeedsCleaning" => Color.Default,
        _ => Color.Default
    };

    public void Dispose() => AppState.OnChange -= HandleBranchChanged;
}