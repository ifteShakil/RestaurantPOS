@page "/admin/categories"
@using RestaurantPOS.Shared.DTOs.Menu
@inject RestaurantPOS.Web.Services.ApiService ApiService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-4" Style="color:#0a1f44; font-weight:700;">
    Menu Categories
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:12px;">
    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
        @(editingId == null ? "Add New Category" : "Edit Category")
    </MudText>

    <div class="d-flex align-items-end gap-3 flex-wrap">
        <MudTextField T="string" @bind-Value="formName" Label="Category Name" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Placeholder="e.g., Main Course" Immediate="true"
                      Style="width:280px;" />

        <MudNumericField T="int" @bind-Value="formDisplayOrder" Label="Display Order"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" HideSpinButtons="true"
                         Style="width:140px;" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@(editingId == null ? Icons.Material.Filled.Add : Icons.Material.Filled.Save)"
                   OnClick="SaveCategory" Style="height:40px;">
            @(editingId == null ? "Add" : "Update")
        </MudButton>

        @if (editingId != null)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="CancelEdit" Style="height:40px;" />
        }
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@errorMessage</MudAlert>
    }
</MudPaper>
@if (categories == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudPaper Elevation="2" Style="border-radius:12px; overflow:hidden;">
        <MudTable Items="categories.OrderBy(c => c.DisplayOrder)" Hover="true" Dense="true"
                  Elevation="0" Class="pa-2"
                  Height="420px" FixedHeader="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Display Order</MudTh>
                <MudTh>Items</MudTh>
                <MudTh Style="text-align:right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name"><MudText Typo="Typo.body2" Style="font-weight:600;">@context.Name</MudText></MudTd>
                <MudTd DataLabel="Display Order"><MudText Typo="Typo.body2">@context.DisplayOrder</MudText></MudTd>
                <MudTd DataLabel="Items">
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">@context.Items.Count items</MudChip>
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align:right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   OnClick="() => EditCategory(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="() => DeleteCategory(context.Id)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

   
}

@code {
    private List<MenuCategoryDto>? categories;
    private string formName = "";
    private int formDisplayOrder = 0;
    private int? editingId = null;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadCategories();

    private async Task LoadCategories() => categories = await ApiService.GetCategoriesAsync();

    private async Task SaveCategory()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(formName))
        {
            errorMessage = "Category name is required.";
            return;
        }

        var dto = new CreateMenuCategoryDto { Name = formName, DisplayOrder = formDisplayOrder };
        bool success = editingId == null
            ? await ApiService.CreateCategoryAsync(dto)
            : await ApiService.UpdateCategoryAsync(editingId.Value, dto);

        if (success)
        {
            Snackbar.Add(editingId == null ? "Category added!" : "Category updated!", Severity.Success);
            ResetForm();
            await LoadCategories();
        }
        else
        {
            errorMessage = "Failed to save.";
        }
    }

    private void EditCategory(MenuCategoryDto c)
    {
        editingId = c.Id;
        formName = c.Name;
        formDisplayOrder = c.DisplayOrder;
    }

    private void CancelEdit() => ResetForm();

    private async Task DeleteCategory(int id)
    {
        var success = await ApiService.DeleteCategoryAsync(id);
        if (success) await LoadCategories();
    }

    private void ResetForm()
    {
        editingId = null;
        formName = "";
        formDisplayOrder = 0;
    }
}