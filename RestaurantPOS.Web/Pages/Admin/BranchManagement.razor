@page "/admin/branches"
@using RestaurantPOS.Shared.DTOs.Branch
@inject RestaurantPOS.Web.Services.ApiService ApiService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4" Style="color:#0a1f44; font-weight:700;">
    Branches
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:12px;">
    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
        @(editingId == null ? "Add New Branch" : "Edit Branch")
    </MudText>

    <div style="display:flex; gap:12px; flex-wrap:wrap;" class="mb-3">
        <MudTextField T="string" @bind-Value="formName" Label="Branch Name" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Style="width:220px;" />
        <MudTextField T="string" @bind-Value="formCode" Label="Code" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Placeholder="e.g., MBB-01" Style="width:140px;" />
        <MudTextField T="string" @bind-Value="formCountryCode" Label="Country Code" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Placeholder="e.g., SZ" Style="width:130px;" />
        <MudTextField T="string" @bind-Value="formCurrencyCode" Label="Currency" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Placeholder="e.g., SZL" Style="width:120px;" />
        <MudTextField T="string" @bind-Value="formCurrencySymbol" Label="Symbol" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Style="width:90px;" />
        <MudNumericField T="decimal" @bind-Value="formTaxRate" Label="Tax %" Variant="Variant.Outlined"
                         Margin="Margin.Dense" HideSpinButtons="true" Format="N2" Style="width:110px;" />
    </div>

    <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-start;">
        <MudTextField T="string" @bind-Value="formTimeZone" Label="Timezone" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Placeholder="e.g., Africa/Mbabane" Style="width:220px;" />
        <MudTextField T="string" @bind-Value="formLocale" Label="Locale" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Placeholder="e.g., en-SZ" Style="width:120px;" />
        <MudTextField T="string" @bind-Value="formAddress" Label="Address" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Style="width:280px;" />
        <MudTextField T="string" @bind-Value="formPhone" Label="Phone (optional)" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Style="width:160px;" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@(editingId == null ? Icons.Material.Filled.Add : Icons.Material.Filled.Save)"
                   OnClick="SaveBranch" Style="height:40px;">
            @(editingId == null ? "Add" : "Update")
        </MudButton>
        @if (editingId != null)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="CancelEdit" Style="height:40px;" />
        }
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@errorMessage</MudAlert>
    }
</MudPaper>

@if (branches == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudPaper Elevation="2" Style="border-radius:12px; overflow:hidden;">
        <MudTable Items="branches" Hover="true" Dense="true" Elevation="0" Class="pa-2"
                  Height="420px" FixedHeader="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Code</MudTh>
                <MudTh>Country</MudTh>
                <MudTh>Currency</MudTh>
                <MudTh Style="text-align:right;">Tax %</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align:right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name"><MudText Typo="Typo.body2" Style="font-weight:600;">@context.Name</MudText></MudTd>
                <MudTd DataLabel="Code"><MudText Typo="Typo.body2">@context.Code</MudText></MudTd>
                <MudTd DataLabel="Country"><MudText Typo="Typo.body2">@context.CountryCode</MudText></MudTd>
                <MudTd DataLabel="Currency"><MudText Typo="Typo.body2">@context.CurrencyCode</MudText></MudTd>
                <MudTd DataLabel="Tax %" Style="text-align:right;"><MudText Typo="Typo.body2">@context.TaxRatePercent%</MudText></MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsActive? Color.Success: Color.Default)">
                        @(context.IsActive ? "Active" : "Inactive")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align:right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   OnClick="() => EditBranch(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error"
                                   OnClick="() => DeactivateBranch(context.Id)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private List<BranchDto>? branches;

    private string formName = "";
    private string formCode = "";
    private string formCountryCode = "";
    private string formCurrencyCode = "";
    private string formCurrencySymbol = "";
    private decimal formTaxRate = 0;
    private string formTimeZone = "";
    private string formLocale = "en-US";
    private string formAddress = "";
    private string formPhone = "";
    private int? editingId = null;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadBranches();

    private async Task LoadBranches() => branches = await ApiService.GetBranchesAsync();

    private async Task SaveBranch()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(formName) || string.IsNullOrWhiteSpace(formCode))
        {
            errorMessage = "Branch name and code are required.";
            return;
        }

        var dto = new CreateBranchDto
        {
            Name = formName,
            Code = formCode,
            CountryCode = formCountryCode,
            CurrencyCode = formCurrencyCode,
            CurrencySymbol = formCurrencySymbol,
            TaxRatePercent = formTaxRate,
            TimeZoneId = formTimeZone,
            LocaleCode = formLocale,
            Address = formAddress,
            Phone = string.IsNullOrWhiteSpace(formPhone) ? null : formPhone
        };

        bool success = editingId == null
            ? await ApiService.CreateBranchAsync(dto)
            : await ApiService.UpdateBranchAsync(editingId.Value, dto);

        if (success)
        {
            Snackbar.Add(editingId == null ? "Branch added!" : "Branch updated!", Severity.Success);
            ResetForm();
            await LoadBranches();
        }
        else
        {
            errorMessage = "Failed to save. Branch code might already exist.";
        }
    }

    private void EditBranch(BranchDto b)
    {
        editingId = b.Id;
        formName = b.Name;
        formCode = b.Code;
        formCountryCode = b.CountryCode;
        formCurrencyCode = b.CurrencyCode;
        formCurrencySymbol = b.CurrencySymbol;
        formTaxRate = b.TaxRatePercent;
        formTimeZone = b.TimeZoneId;
        formLocale = b.LocaleCode;
        formAddress = b.Address;
        formPhone = b.Phone ?? "";
    }

    private void CancelEdit() => ResetForm();

    private async Task DeactivateBranch(int id)
    {
        var success = await ApiService.DeactivateBranchAsync(id);
        if (success)
        {
            Snackbar.Add("Branch deactivated.", Severity.Info);
            await LoadBranches();
        }
    }

    private void ResetForm()
    {
        editingId = null;
        formName = ""; formCode = ""; formCountryCode = ""; formCurrencyCode = "";
        formCurrencySymbol = ""; formTaxRate = 0; formTimeZone = ""; formLocale = "en-US";
        formAddress = ""; formPhone = "";
    }
}