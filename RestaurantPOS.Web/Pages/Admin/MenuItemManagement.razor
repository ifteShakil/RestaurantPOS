<MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:12px;">
    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">
        @(editingId == null ? "Add New Item" : "Edit Item")
    </MudText>

    <div style="display:flex; align-items:flex-start; gap:12px; flex-wrap:wrap;">
        <MudTextField T="string" @bind-Value="formName" Label="Item Name" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Immediate="true" Style="width:220px;" />

        <MudTextField T="string" @bind-Value="formDescription" Label="Description (optional)" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Style="width:240px;" />

        <MudSelect T="int" @bind-Value="formCategoryId" Label="Category" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Style="width:180px;">
            <MudSelectItem T="int" Value="0">-- Category --</MudSelectItem>
            @if (categories != null)
            {
                @foreach (var c in categories)
                {
                    <MudSelectItem T="int" Value="@c.Id">@c.Name</MudSelectItem>
                }
            }
        </MudSelect>

        <MudNumericField T="decimal" @bind-Value="formPrice" Label="Price" Variant="Variant.Outlined"
                         Margin="Margin.Dense" Format="N2" Min="0" HideSpinButtons="true" Style="width:130px;" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@(editingId == null ? Icons.Material.Filled.Add : Icons.Material.Filled.Save)"
                   OnClick="SaveItem" Style="height:40px;">
            @(editingId == null ? "Add" : "Update")
        </MudButton>

        @if (editingId != null)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="CancelEdit" Style="height:40px;" />
        }
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@errorMessage</MudAlert>
    }
</MudPaper>


@if (menuItems == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudPaper Elevation="2" Style="border-radius:12px; overflow:hidden;">
        <MudTable Items="menuItems" Hover="true" Dense="true" Elevation="0" Class="pa-2" Height="420px" FixedHeader="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Category</MudTh>
                <MudTh Style="text-align:right;">Price</MudTh>
                <MudTh>Available</MudTh>
                <MudTh Style="text-align:right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name"><MudText Style="font-weight:600;">@context.Name</MudText></MudTd>
                <MudTd DataLabel="Category">@context.CategoryName</MudTd>
                <MudTd DataLabel="Price" Style="text-align:right; font-weight:600;">
                    @context.CurrencyCode @context.Price.ToString("N2")
                </MudTd>
                <MudTd DataLabel="Available">
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsAvailable? Color.Success: Color.Default)">
                        @(context.IsAvailable ? "Yes" : "No")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align:right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   OnClick="() => EditItem(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="() => DeleteItem(context.Id)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private List<MenuItemDto>? menuItems;
    private List<MenuCategoryDto>? categories;

    private string formName = "";
    private string formDescription = "";
    private int formCategoryId = 0;
    private decimal formPrice = 0;
    private int? editingId = null;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += HandleBranchChanged;
        categories = await ApiService.GetCategoriesAsync();
        await LoadItems();
    }

    private async Task LoadItems() => menuItems = await ApiService.GetMenuByBranchAsync(AppState.CurrentBranchId);

    private async void HandleBranchChanged()
    {
        await LoadItems();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveItem()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(formName) || formCategoryId == 0)
        {
            errorMessage = "Name and Category are required.";
            return;
        }

        var dto = new CreateMenuItemDto
        {
            Name = formName,
            Description = formDescription,
            BasePrice = formPrice,
            CategoryId = formCategoryId
        };

        bool success = editingId == null
            ? await ApiService.CreateMenuItemAsync(dto)
            : await ApiService.UpdateMenuItemAsync(editingId.Value, dto);

        if (success)
        {
            ResetForm();
            await LoadItems();
        }
        else
        {
            errorMessage = "Failed to save.";
        }
    }

    private void EditItem(MenuItemDto item)
    {
        editingId = item.Id;
        formName = item.Name;
        formDescription = item.Description ?? "";
        formCategoryId = item.CategoryId;
        formPrice = item.Price;
    }

    private void CancelEdit() => ResetForm();

    private async Task DeleteItem(int id)
    {
        var success = await ApiService.DeleteMenuItemAsync(id);
        if (success) await LoadItems();
    }

    private void ResetForm()
    {
        editingId = null;
        formName = "";
        formDescription = "";
        formCategoryId = 0;
        formPrice = 0;
    }

    public void Dispose() => AppState.OnChange -= HandleBranchChanged;
}