@page "/admin/users"
@using RestaurantPOS.Shared.DTOs.User
@inject RestaurantPOS.Web.Services.ApiService ApiService
@inject RestaurantPOS.Web.Services.AppState AppState
@inject ISnackbar Snackbar
@implements IDisposable

<MudText Typo="Typo.h5" Class="mb-4" Style="color:#0a1f44; font-weight:700;">
    Staff — @AppState.CurrentBranchName
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2" Style="border-radius:12px;">
    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600;">Add New Staff</MudText>

    <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-start;">
        <MudTextField T="string" @bind-Value="formFullName" Label="Full Name" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Style="width:200px;" />
        <MudTextField T="string" @bind-Value="formUsername" Label="Username" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Style="width:160px;" />
        <MudTextField T="string" @bind-Value="formPassword" Label="Password" Variant="Variant.Outlined"
                      InputType="InputType.Password" Margin="Margin.Dense" Style="width:160px;" />
        <MudSelect T="string" @bind-Value="formRole" Label="Role" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Style="width:180px;">
            <MudSelectItem T="string" Value="@("")">-- Role --</MudSelectItem>
            <MudSelectItem T="string" Value="@("BranchManager")">Branch Manager</MudSelectItem>
            <MudSelectItem T="string" Value="@("Cashier")">Cashier</MudSelectItem>
            <MudSelectItem T="string" Value="@("Waiter")">Waiter</MudSelectItem>
            <MudSelectItem T="string" Value="@("KitchenStaff")">Kitchen Staff</MudSelectItem>
            <MudSelectItem T="string" Value="@("SuperAdmin")">Super Admin</MudSelectItem>
        </MudSelect>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddUser" Style="height:40px;">
            Add
        </MudButton>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@errorMessage</MudAlert>
    }
</MudPaper>

@if (users == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudPaper Elevation="2" Style="border-radius:12px; overflow:hidden;">
        <MudTable Items="users" Hover="true" Dense="true" Elevation="0" Class="pa-2"
                  Height="420px" FixedHeader="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Username</MudTh>
                <MudTh>Role</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align:right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name"><MudText Typo="Typo.body2" Style="font-weight:600;">@context.FullName</MudText></MudTd>
                <MudTd DataLabel="Username"><MudText Typo="Typo.body2">@context.Username</MudText></MudTd>
                <MudTd DataLabel="Role">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.Role</MudChip>
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsActive? Color.Success: Color.Default)">
                        @(context.IsActive ? "Active" : "Inactive")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align:right;">
                    @if (context.IsActive)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error"
                                       OnClick="() => DeactivateUser(context.Id)" />
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private List<UserDto>? users;

    private string formFullName = "";
    private string formUsername = "";
    private string formPassword = "";
    private string formRole = "";
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += HandleBranchChanged;
        await LoadUsers();
    }

    private async Task LoadUsers() => users = await ApiService.GetUsersByBranchAsync(AppState.CurrentBranchId);

    private async void HandleBranchChanged()
    {
        await LoadUsers();
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddUser()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(formFullName) || string.IsNullOrWhiteSpace(formUsername)
            || string.IsNullOrWhiteSpace(formPassword) || string.IsNullOrWhiteSpace(formRole))
        {
            errorMessage = "All fields are required.";
            return;
        }

        var dto = new CreateUserDto
        {
            FullName = formFullName,
            Username = formUsername,
            Password = formPassword,
            Role = formRole,
            BranchId = formRole == "SuperAdmin" ? null : AppState.CurrentBranchId
        };

        var success = await ApiService.CreateUserAsync(dto);
        if (success)
        {
            Snackbar.Add("Staff member added!", Severity.Success);
            formFullName = ""; formUsername = ""; formPassword = ""; formRole = "";
            await LoadUsers();
        }
        else
        {
            errorMessage = "Failed to save. Username might already exist.";
        }
    }

    private async Task DeactivateUser(int id)
    {
        var success = await ApiService.DeactivateUserAsync(id);
        if (success)
        {
            Snackbar.Add("Staff deactivated.", Severity.Info);
            await LoadUsers();
        }
    }

    public void Dispose() => AppState.OnChange -= HandleBranchChanged;
}