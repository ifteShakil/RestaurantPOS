@page "/order/{OrderId:int}/void/{ItemId:int}/{Quantity:int}"
@layout EmptyLayout
@using RestaurantPOS.Shared.DTOs.Order
@inject RestaurantPOS.Web.Services.ApiService ApiService
@inject RestaurantPOS.Web.Services.AuthState AuthState
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage
@inject IJSRuntime JS


<style>
    @@media print {
        .no-print {
            display: none;
        }
    }

    body {
        font-family: 'Courier New', monospace;
        background: #eee;
    }

    .ticket {
        width: 302px;
        margin: 0 auto;
        padding: 12px;
        background: white;
        border: 3px solid #c62828;
    }

        .ticket h2 {
            text-align: center;
            color: #c62828;
            margin: 4px 0;
        }

    .row {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        margin: 2px 0;
    }

    .big {
        font-size: 18px;
        font-weight: bold;
    }

    hr {
        border: none;
        border-top: 1px dashed #000;
        margin: 6px 0;
    }

    .cancelled-item {
        font-size: 14px;
        text-decoration: line-through;
        margin: 6px 0;
    }

    .void-label {
        text-align: center;
        font-weight: bold;
        color: #c62828;
        margin-top: 8px;
        font-size: 14px;
    }
</style>



@if (isLoading)
{
    <p class="no-print" style="text-align:center; padding:24px;">Loading...</p>
}
else if (order == null || cancelledItem == null)
{
    <p class="no-print" style="text-align:center; padding:24px; color:red;">
        Could not load item. Please try again from the Order Detail page.
    </p>
}
else
{
    <div class="no-print" style="text-align:center; padding:16px;">
        <button @onclick="PrintNow" style="padding:8px 20px;">🖨️ Print Void Ticket</button>
    </div>

    <div class="ticket">
        <h2>⚠ CANCEL ORDER ⚠</h2>
        <div class="row"><span class="big">Ticket #@order.DailyTicketNumber</span><span>Table @order.TableName</span></div>
        <div class="row"><span>Order #@order.Id</span><span>@DateTime.Now.ToString("hh:mm tt")</span></div>
        <hr />
        <div class="cancelled-item"><strong>@Quantity x</strong> @cancelledItem.MenuItemName.ToUpper()</div>
        <div class="void-label">-- CANCELLED --</div>
    </div>
}




@code {
    [Parameter] public int OrderId { get; set; }
    [Parameter] public int ItemId { get; set; }
    [Parameter] public int Quantity { get; set; }
    private OrderDto? order;
    private OrderItemDto? cancelledItem;
    private bool isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!AuthState.IsLoggedIn)
            {
                try
                {
                    var tokenResult = await SessionStorage.GetAsync<string>("authToken");
                    var userResult = await SessionStorage.GetAsync<RestaurantPOS.Shared.DTOs.User.UserDto>("authUser");

                    if (tokenResult.Success && userResult.Success && tokenResult.Value != null && userResult.Value != null)
                    {
                        AuthState.SetAuth(tokenResult.Value, userResult.Value);
                    }
                }
                catch
                {
                    // ignore
                }
            }

            order = await ApiService.GetOrderAsync(OrderId);
            cancelledItem = order?.Items.FirstOrDefault(i => i.Id == ItemId);
            isLoading = false;
            StateHasChanged();

            if (cancelledItem != null)
            {
                await Task.Delay(200);
                await PrintNow();
            }
        }
    }

    private async Task PrintNow() => await JS.InvokeVoidAsync("print");
}

