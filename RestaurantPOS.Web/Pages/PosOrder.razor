@page "/order"
@using RestaurantPOS.Shared.DTOs.Menu
@using RestaurantPOS.Shared.DTOs.Order
@using RestaurantPOS.Shared.DTOs.Table
@inject RestaurantPOS.Web.Services.ApiService ApiService
@inject RestaurantPOS.Web.Services.AppState AppState
@inject NavigationManager Nav

<MudText Typo="Typo.h5" Class="mb-4" Style="color:#0a1f44; font-weight:700;">
    New Order — @AppState.CurrentBranchName
</MudText>

@if (menuItems == null || tables == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudGrid>
        <!-- বাম দিক: Search, Filter, Menu Grid -->
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-3 mb-3" Elevation="1" Style="border-radius:10px;">
                <MudTextField T="string" @bind-Value="searchText" @bind-Value:after="ApplyFilter"
                              Placeholder="Search menu items..." Variant="Variant.Outlined"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" Clearable="true" Class="mb-3" />

                <MudChipSet T="string" SelectedValue="selectedCategory" SelectedValueChanged="OnCategoryChanged"
                            Filter="true" Mandatory="true">
                    <MudChip Value="@("All")" Color="Color.Primary"
                             Variant="@(selectedCategory == "All" ? Variant.Filled : Variant.Outlined)">All</MudChip>
                    @foreach (var cat in categoryNames)
                    {
                        <MudChip Value="@cat" Color="Color.Primary"
                                 Variant="@(selectedCategory == cat ? Variant.Filled : Variant.Outlined)">@cat</MudChip>
                    }
                </MudChipSet>
            </MudPaper>

            <MudGrid>
                @foreach (var item in filteredItems)
                {
                    <MudItem xs="12" sm="6" lg="4">
                        <MudPaper Class="pa-3" Elevation="2" Style="border-radius:10px; height:100%; display:flex; flex-direction:column; justify-content:space-between;">
                            <div>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@item.Name</MudText>
                                <MudText Typo="Typo.body2" Style="color:#0a1f44; font-weight:600;">@item.CurrencyCode @item.Price.ToString("N2")</MudText>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       FullWidth="true" Class="mt-2"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="() => AddToCart(item)">
                                Add
                            </MudButton>
                        </MudPaper>
                    </MudItem>
                }
                @if (!filteredItems.Any())
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info">No items match your search.</MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>

        <!-- ডান দিক: Sticky Cart Panel -->
        <MudItem xs="12" md="4">
            <div style="position:sticky; top:16px;">
                <MudPaper Class="pa-4" Elevation="3" Style="border-radius:12px;">
                    <MudText Typo="Typo.h6" Class="mb-2" Style="font-weight:700;">Select Table</MudText>
                    <MudSelect T="int" @bind-Value="selectedTableId" Variant="Variant.Outlined" Dense="true" Class="mb-4">
                        <MudSelectItem T="int" Value="0">-- Select Table --</MudSelectItem>
                        @foreach (var table in tables)
                        {
                            <MudSelectItem T="int" Value="@table.Id">@table.Name (@table.Capacity seat)</MudSelectItem>
                        }
                    </MudSelect>

                    <MudDivider Class="mb-3" />

                    <MudText Typo="Typo.h6" Class="mb-2" Style="font-weight:700;">
                        Cart (@cart.Sum(c => c.Quantity) items)
                    </MudText>

                    @if (!cart.Any())
                    {
                        <MudText Typo="Typo.body2" Style="opacity:0.6;">No items added yet.</MudText>
                    }
                    else
                    {
                        <MudList T="string" Dense="true">
                            @foreach (var line in cart)
                            {
                                <MudListItem T="string">
                                    <div style="display:flex; align-items:center; justify-content:space-between; width:100%;">
                                        <div style="flex:1;">
                                            <MudText Typo="Typo.body2" Style="font-weight:600;">@line.Name</MudText>
                                            <MudText Typo="Typo.caption">@line.CurrencyCode @line.UnitPrice.ToString("N2") each</MudText>
                                        </div>
                                        <div style="display:flex; align-items:center; gap:4px;">
                                            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                                           OnClick="() => DecrementQty(line)" />
                                            <MudText Typo="Typo.body2">@line.Quantity</MudText>
                                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                                           OnClick="() => IncrementQty(line)" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                           OnClick="() => cart.Remove(line)" />
                                        </div>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>

                        <MudDivider Class="my-3" />

                        <div style="display:flex; justify-content:space-between;">
                            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Total</MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">
                                @(cart.FirstOrDefault()?.CurrencyCode ?? "") @cart.Sum(c => c.UnitPrice * c.Quantity).ToString("N2")
                            </MudText>
                        </div>
                    }

                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="mt-4"
                               Size="Size.Large"
                               Disabled="@(cart.Count == 0 || selectedTableId == 0)"
                               OnClick="SubmitOrder">
                        Submit Order
                    </MudButton>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2" Dense="true">@errorMessage</MudAlert>
                    }
                </MudPaper>
            </div>
        </MudItem>
    </MudGrid>
}

@code {
    private const int WaiterId = 1;
    private int BranchId => AppState.CurrentBranchId;

    private List<MenuItemDto>? menuItems;
    private List<MenuItemDto> filteredItems = new();
    private List<string> categoryNames = new();
    private List<TableDto>? tables;

    private string searchText = "";
    private string selectedCategory = "All";
    private int selectedTableId = 0;
    private string? errorMessage;

    private List<CartLine> cart = new();

    protected override async Task OnInitializedAsync()
    {
        menuItems = await ApiService.GetMenuByBranchAsync(BranchId);
        categoryNames = menuItems?.Select(m => m.CategoryName).Distinct().OrderBy(c => c).ToList() ?? new();

        var allTables = await ApiService.GetTablesByBranchAsync(BranchId);
        tables = allTables?.Where(t => t.Status == "Available").ToList();

        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (menuItems == null) return;

        var query = menuItems.AsEnumerable();

        if (selectedCategory != "All")
            query = query.Where(m => m.CategoryName == selectedCategory);

        if (!string.IsNullOrWhiteSpace(searchText))
            query = query.Where(m => m.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));

        filteredItems = query.ToList();
    }

    private void OnCategoryChanged(string category)
    {
        selectedCategory = category;
        ApplyFilter();
    }

    private void AddToCart(MenuItemDto item)
    {
        var existing = cart.FirstOrDefault(c => c.MenuItemId == item.Id);
        if (existing != null)
        {
            existing.Quantity++;
        }
        else
        {
            cart.Add(new CartLine
            {
                MenuItemId = item.Id,
                Name = item.Name,
                UnitPrice = item.Price,
                CurrencyCode = item.CurrencyCode,
                Quantity = 1
            });
        }
    }

    private void IncrementQty(CartLine line) => line.Quantity++;

    private void DecrementQty(CartLine line)
    {
        line.Quantity--;
        if (line.Quantity <= 0) cart.Remove(line);
    }

    private async Task SubmitOrder()
    {
        errorMessage = null;
        try
        {
            var dto = new CreateOrderDto
            {
                BranchId = BranchId,
                TableId = selectedTableId,
                WaiterId = WaiterId,
                Items = cart.Select(c => new CreateOrderItemDto
                {
                    MenuItemId = c.MenuItemId,
                    Quantity = c.Quantity
                }).ToList()
            };

            var order = await ApiService.CreateOrderAsync(dto);
            if (order != null)
            {
                Nav.NavigateTo($"/order/{order.Id}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create order: {ex.Message}";
        }
    }

    private class CartLine
    {
        public int MenuItemId { get; set; }
        public string Name { get; set; } = string.Empty;
        public decimal UnitPrice { get; set; }
        public string CurrencyCode { get; set; } = string.Empty;
        public int Quantity { get; set; }
    }
}